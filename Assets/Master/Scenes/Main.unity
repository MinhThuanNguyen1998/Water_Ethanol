  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Cho h\u1ED7n h\u1EE3p n\u01B0\u1EDBc \u2013 ethanol v\xE0o b\xECnh c\u1EA7u.\n\nL\u1EAFp
    d\u1EE5ng c\u1EE5 ch\u01B0ng c\u1EA5t (\u0111\u1EA3m b\u1EA3o k\xEDn, c\xF3 sinh
    h\xE0n \u0111\u1EC3 ng\u01B0ng t\u1EE5 h\u01A1i).\n\nKhi nhi\u1EC7t k\u1EBF ch\u1EC9
    ~78\xB0C, ethanol b\u1EAFt \u0111\u1EA7u bay h\u01A1i v\xE0 ng\u01B0ng t\u1EE5
    th\xE0nh gi\u1ECDt \u1EDF \u0111\u1EA7u \u1ED1ng sinh h\xE0n.\n\nThu ph\u1EA7n
    ch\u01B0ng c\u1EA5t \u1EDF giai \u0111o\u1EA1n n\xE0y: r\u01B0\u1EE3u c\xF3 n\u1ED3ng
    \u0111\u1ED9 cao (g\u1EA7n 95%).\n\nKhi nhi\u1EC7t \u0111\u1ED9 b\u1EAFt \u0111\u1EA7u
    t\u0103ng l\xEAn >90\xB0C, ng\u1EEBng thu ph\u1EA7n \u0111\u1EA7u \u2192 l\xFAc
    n\xE0y h\u01A1i ch\u1EE9a nhi\u1EC1u n\u01B0\u1EDBc h\u01A1n.\n\nPh\u1EA7n c\xF2n
    l\u1EA1i trong b\xECnh l\xE0 dung d\u1ECBch ch\u1EE9a nhi\u1EC1u n\u01B0\u1EDBc."
  m_isRightToLeft: 0
