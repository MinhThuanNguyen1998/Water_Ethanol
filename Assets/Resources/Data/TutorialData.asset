  m_data:
  - buttonName: Menu
    buttonContent: "N\xFAt tr\u1EDF v\u1EC1 menu ch\xEDnh c\u1EE7a ph\u1EA7n m\u1EC1m"
    buttonAudio: {fileID: 8300000, guid: 87003c9629397cf49a0fc8af65611b34, type: 3}
  - buttonName: "T\u1EA3i l\u1EA1i th\xED nghi\u1EC7m"
    buttonContent: "N\xFAt t\u1EA3i l\u1EA1i th\xEC nghi\u1EC7m t\u1EEB \u0111\u1EA7u"
    buttonAudio: {fileID: 8300000, guid: 21a287c02b0922d49bbe8eed9863466a, type: 3}
  - buttonName: "Chi ti\u1EBFt th\xED nghi\u1EC7m"
    buttonContent: "N\xFAt hi\u1EC3n th\u1ECB chi ti\u1EBFt t\u1EEBng b\u01B0\u1EDBc
      \u0111\u1EC3 th\u1EF1c hi\u1EC7n th\xED nghi\u1EC7m trong ph\u1EA7n m\u1EC1m"
    buttonAudio: {fileID: 8300000, guid: 8727dfceca6bafc4792755bbaed30ec2, type: 3}
  - buttonName: "L\xFD thuy\u1EBFt"
    buttonContent: "N\xFAt hi\u1EC3n th\u1ECB l\xFD thuy\u1EBFt \u0111\u1EC3 th\u1EF1c
      hi\u1EC7n th\xED nghi\u1EC7m "
    buttonAudio: {fileID: 8300000, guid: 03897a348042dd14185af95f33312ccd, type: 3}
  - buttonName: "Ch\u1EBF \u0111\u1ED9 g\u1EE3i \xFD"
    buttonContent: "N\xFAt \u0111\u1EC3 b\u1EADt ch\u1EBF \u0111\u1ED9 g\u1EE3i \xFD"
    buttonAudio: {fileID: 8300000, guid: bef87dc22f6ac9b40b45e9e990ba4ede, type: 3}
  - buttonName: "Ch\u1EC9nh t\u1ED1c \u0111\u1ED9 nh\u1ECF gi\u1ECDt"
    buttonContent: "N\xFAt d\xF9ng ch\u1EC9nh t\u1ED1c \u0111\u1ED9 nh\u1ECF gi\u1ECDt"
    buttonAudio: {fileID: 8300000, guid: 9a52831a4ebe1714eb7ac24cf5e15058, type: 3}
  - buttonName: "N\u1ED3i"
    buttonContent: "D\xF9ng \u0111\u1EC3 ch\u1EE9a h\u1ED7n h\u1EE3p v\xE0 \u0111un
      n\xF3ng"
    buttonAudio: {fileID: 8300000, guid: 76f290a1837bbe340bcff92719342d1b, type: 3}
  - buttonName: "B\u1EBFp ga"
    buttonContent: "D\xF9ng \u0111\u1EC3 \u0111un n\xF3ng h\u1ED7n h\u1EE3p n\u01B0\u1EDBc
      v\xE0 c\u1ED3n"
    buttonAudio: {fileID: 8300000, guid: 6ca63c78ca16bb04cbc916e9106aa204, type: 3}
  - buttonName: "\u1ED0ng d\u1EABn kh\xED"
    buttonContent: "L\xE0 \u0111\u01B0\u1EDDng \u1ED1ng \u0111\u01B0a h\u01A1i c\u1ED3n
      sang n\u01A1i l\xE0m l\u1EA1nh "
    buttonAudio: {fileID: 8300000, guid: 5cd115ab3db75704aa7e14aeac885539, type: 3}
  - buttonName: "\u1ED0ng sinh h\xE0n"
    buttonContent: "D\xF9ng \u0111\u1EC3 l\xE0m l\u1EA1nh v\xE0 ng\u01B0ng t\u1EE5
      h\u01A1i th\xE0nh ch\u1EA5t l\u1ECFng"
    buttonAudio: {fileID: 8300000, guid: 7ab9346a006d5134e8ba1002e82bc67d, type: 3}
  - buttonName: "\u1ED0ng d\u1EABn n\u01B0\u1EDBc v\xE0o sinh h\xE0n"
    buttonContent: "D\xF9ng \u0111\u1EC3 \u0111\u01B0a n\u01B0\u1EDBc l\u1EA1nh v\xE0o
      sinh h\xE0n"
    buttonAudio: {fileID: 8300000, guid: dc503a61685b1344cbd9068f59e009f2, type: 3}
  - buttonName: "\u1ED0ng d\u1EABn n\u01B0\u1EDBc ra sinh h\xE0n"
    buttonContent: "D\xF9ng \u0111\u1EC3 tho\xE1t n\u01B0\u1EDBc n\xF3ng"
    buttonAudio: {fileID: 8300000, guid: 04c61319d85e59144971564594bfbf2e, type: 3}
  - buttonName: "B\xECnh ng\u01B0ng"
    buttonContent: "N\u01A1i ch\u1EE9a ph\u1EA7n ch\u1EA5t l\u1ECFng \u0111\xE3 \u0111\u01B0\u1EE3c
      ng\u01B0ng t\u1EE5"
    buttonAudio: {fileID: 8300000, guid: 00d0b3b4c04447249827c35065409fd0, type: 3}
  - buttonName: "Gi\xE1 \u0111\u1EE1"
    buttonContent: "D\xF9ng \u0111\u1EC3 c\u1ED1 \u0111\u1ECBnh v\xE0 gi\u1EEF c\xE1c
      d\u1EE5ng c\u1EE5 th\xED nghi\u1EC7m"
    buttonAudio: {fileID: 8300000, guid: 37fafe392df6f1b44b5635b0ad154142, type: 3}
